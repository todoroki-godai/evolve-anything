#!/usr/bin/env python3
"""bin/evolve-daily-run — launchd が毎朝呼ぶ daily runner（#80 Phase 1b, #194）。

`fleet ingest`（全 PJ 発話取込・ゼロ LLM）→ `fleet detect`（決定論 weak_signals 検出）→
`correction_semantic.judge_runner.run_daily_judge`（llm_judge Phase B・意味判定・#408）→
`fleet queue --json`（待ち判定）を順に実行し、queue の JSON を
`$CLAUDE_PLUGIN_DATA/evolve-queue.json` に保存する。SessionStart hook（restore_state）が
保存結果を読んで通知する。

**LLM 呼び出しについて（#410 で旧記述を是正）**: 本 runner の大半は決定論パイプラインだが、
llm_judge ステップだけは Haiku を無人で呼ぶ（`safe_llm_call.call_claude_headless` 経由・
判定対象の生ログに prompt injection が混入していてもツールを一切実行させない安全化済み。
1日の件数/トークン上限は userConfig で制御）。他の全ステップ（ingest/detect/queue/icebox系）
はゼロ LLM のまま。

加えて `gh issue list --label icebox --state closed`（read-only）で icebox 棚卸しの
気づきトリガー用の集計（件数・最古経過日数）を `$CLAUDE_PLUGIN_DATA/icebox-status.json` に
保存する（#194）。read-only の issue 一覧取得なので account switch は不要。

さらに（#352）別の `gh issue list`（`--json number,body,closedAt,updatedAt`）で icebox issue
本文の `reopen-when` ブロックを実ストアと決定論突合し、3レーン（成立/観測器不在/失効候補）
判定を `$CLAUDE_PLUGIN_DATA/icebox-verdicts.json` に保存する。SessionStart hook
（restore_state）がこれを読んで成立分のみ名指し、audit が観測器不在/失効候補を advisory
surface する。gh 呼び出しは read-only なので account switch は不要。失敗しても daily-run
全体は落とさない（fail-open、上の icebox 集計ステップと同型）。

stdout/stderr は launchd plist の StandardOut/ErrorPath（evolve-daily.log）に集約され、
エラー時のスタックがログに残る。
"""
import json
import os
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

_PLUGIN_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(_PLUGIN_ROOT / "scripts" / "lib"))

import icebox_reconcile  # noqa: E402
import rl_common  # noqa: E402
from correction_semantic import judge_runner  # noqa: E402
from daily import plist as plist_mod  # noqa: E402
from rl_common.config import load_user_config  # noqa: E402
from rl_common.file_lock import atomic_write_text  # noqa: E402

# icebox 棚卸し対象リポジトリ（evolve-anything 自身）。
ICEBOX_REPO = "todoroki-godai/evolve-anything"
ICEBOX_STATUS_FILE_NAME = "icebox-status.json"
# gh はネットワークを叩く最初の daily ステップ。ハングすると launchd の daily-run が
# 無期限ブロックするため timeout で保険をかける（fail-open で継続）。
ICEBOX_GH_TIMEOUT_SECONDS = 30
# #352 B8: gh は新しい順に返すため limit を超えると**最古**集合が切り捨てられる。
# icebox 3レーン棚卸しのレーン3（失効候補）はまさに「凍結から最も古い」issue を対象に
# するため、旧 limit=100 は運用が積み上がるとレーン3が構造的に消え「失効候補 0件 ✓」と
# 嘘の clean を出しうる。十分大きい値にし、それでも達した場合は取りこぼしを可視化する。
ICEBOX_GH_LIST_LIMIT = 1000


def _icebox_oldest_days(issues, now: datetime) -> "tuple[int, int]":
    """`gh issue list --json closedAt` の出力（dict のリスト）から (最古経過日数, パース成功件数) を返す。

    issues が空、または全要素の closedAt がパース不能なら oldest_days=0 を返す
    （threshold 未満なので icebox_notice.build_icebox_notice は沈黙する。count は
    len(issues) で独立に計算されるため、パース不能時も 0 とは限らない）。
    パース成功件数は呼び出し側が「count>0 なのにパース成功 0 件」という恒久沈黙モード
    （gh の JSON 形式変更等）を stderr warning で可視化するための値。
    """
    days = []
    for item in issues:
        if not isinstance(item, dict):
            continue
        ts = item.get("closedAt")
        if not isinstance(ts, str) or not ts:
            continue
        try:
            dt = datetime.fromisoformat(ts.replace("Z", "+00:00"))
        except ValueError:
            continue
        if dt.tzinfo is None:
            dt = dt.replace(tzinfo=timezone.utc)
        days.append((now - dt).days)
    return (max(days) if days else 0, len(days))


def main() -> int:
    env = os.environ.get("CLAUDE_PLUGIN_DATA", "")
    data_dir = rl_common.resolve_data_dir(env)
    data_dir.mkdir(parents=True, exist_ok=True)
    (data_dir / "logs").mkdir(parents=True, exist_ok=True)

    fleet_bin = str(_PLUGIN_ROOT / "bin" / "evolve-fleet")
    out_path = Path(plist_mod.queue_json_path(str(data_dir)))

    # evolve-fleet を bare パスで起動すると shebang（#!/usr/bin/env python3）が launchd の
    # 最小 PATH で /usr/bin の古い Python に落ちて import 時 TypeError で死ぬ。この runner が走る
    # インタプリタ（launchd plist で pin 済み）を明示的に渡して同じ Python で子を実行する。
    fleet = [sys.executable, fleet_bin]

    # 1) 全 PJ 発話取込（ゼロ LLM）。失敗しても queue は古い取込で判定できるので継続。
    print(f"[evolve-daily-run] fleet ingest …", flush=True)
    rc_ingest = subprocess.run(fleet + ["ingest"]).returncode
    if rc_ingest != 0:
        print(f"[evolve-daily-run] fleet ingest exited {rc_ingest}（continue）", file=sys.stderr, flush=True)

    # 1b) 増分 token 消費取込（ゼロ LLM・#157）。token_usage_ingest は session_progress
    # カーソル + INSERT OR IGNORE で冪等・増分。既定の 90 日ウィンドウで transcript を走査する。
    # 失敗しても queue 判定には無関係なので継続（ingest と同じ扱い）。
    print(f"[evolve-daily-run] fleet tokens --backfill …", flush=True)
    rc_tokens = subprocess.run(fleet + ["tokens", "--backfill"]).returncode
    if rc_tokens != 0:
        print(f"[evolve-daily-run] fleet tokens --backfill exited {rc_tokens}（continue）", file=sys.stderr, flush=True)

    # 1c) 全 PJ の決定論 weak_signals 検出（ゼロ LLM・冪等・#304）。
    # これが無いと素材は `evolve --drain` の apply 境界でしか生まれず、evolve を回さない限り
    # queue が永久に EMPTY になる（鶏卵ループ）。検出は signal_key dedup で冪等なので毎朝
    # 回してよい。LLM 判定を要するチャネルは従来どおり対話 evolve 側に残す（無人で承認待ち
    # ハングしない設計は維持）。失敗しても queue 判定は続行（ingest と同じ fail-open）。
    # detect の stdout（失敗 dir 数・全滅/一部失敗 PJ の内訳・未帰属除外件数を含む最終サマリ）は
    # この runner のログにそのまま流れる。一部 dir だけ失敗した PJ も「一部」として出るので、
    # rc=0 でも劣化は追える。非 zero は「全 PJ 失敗 or ソース読み込み失敗」だけを意味する（#313）。
    print(f"[evolve-daily-run] fleet detect …", flush=True)
    rc_detect = subprocess.run(fleet + ["detect", "--quiet"]).returncode
    if rc_detect != 0:
        print(
            f"[evolve-daily-run] fleet detect exited {rc_detect}"
            "（全 PJ 検出失敗 or ソース読み込み失敗 — 上のサマリ参照・continue）",
            file=sys.stderr, flush=True,
        )

    # 1d) llm_judge Phase B（意味判定）を非対話で回す（#408）。SKILL.md Step 6.6 の
    # 対話 y/n 承認時インライン判定にしか実体が無く2ヶ月供給が止まっていた区間を、daily
    # runner から直接 Python 呼び出しする（icebox_reconcile と同型・非 subprocess）。
    # queue の material 計数に載るよう queue 判定より前に置く。1日の件数/トークン上限は
    # userConfig（judge_daily_utterance_limit / judge_daily_token_limit）から渡す。
    # 失敗しても daily-run 全体は落とさない（fail-open、他ステップと同型）。
    print(f"[evolve-daily-run] llm_judge daily run …", flush=True)
    judge_summary = None
    try:
        user_config = load_user_config()
        judge_result = judge_runner.run_daily_judge(
            run=True,
            daily_utterance_limit=int(user_config.get(
                "judge_daily_utterance_limit", judge_runner.DEFAULT_DAILY_UTTERANCE_LIMIT
            )),
            daily_token_limit=int(user_config.get(
                "judge_daily_token_limit", judge_runner.DEFAULT_DAILY_TOKEN_LIMIT
            )),
        )
        judge_summary = {
            "unjudged_before": judge_result.get("unjudged_total", 0),
            "selected": judge_result.get("selected", 0),
            "capped": bool(judge_result.get("capped", False)),
            "corrections": judge_result.get("corrections", 0),
            "call_failed": judge_result.get("call_failed", 0),
            # #410 [Must]E: 発話ソース（utterances.db）取得の DB/schema 障害を
            # capped=False の健康そうなサマリに埋もれさせない（silence != evaluated）。
            "source_failed": bool(judge_result.get("source_failed", False)),
            "source_error": judge_result.get("source_error"),
            # #410 round2 [Should]②: 別プロセスが lock 保持中で non-blocking skip したことを
            # 沈黙させない（無期限待機の代わりに skip する設計にしたため、skip 自体が
            # observability から消えないよう surface する）。
            "skipped_locked": bool(judge_result.get("skipped_locked", False)),
        }
    except Exception as e:  # noqa: BLE001 - fail-open（他ステップと同型）
        print(f"[evolve-daily-run] llm_judge daily run error: {e}（continue）", file=sys.stderr, flush=True)

    # 2) 待ち判定（--json）。stdout に llm_judge サマリを追加して evolve-queue.json に保存
    # （新ストアを作らず既存の read 専用派生物を再利用・#408）。
    print(f"[evolve-daily-run] fleet queue --json → {out_path}", flush=True)
    result = subprocess.run(fleet + ["queue", "--json"], capture_output=True, text=True)
    queue_rc = result.returncode
    if queue_rc != 0:
        # queue 失敗は run 失敗として最後に非ゼロで返すが、後続の icebox ステップは
        # 実行する（補助ステップまで巻き添えにしない）。
        print(
            f"[evolve-daily-run] fleet queue failed (rc={queue_rc}):\n{result.stderr}",
            file=sys.stderr,
            flush=True,
        )
    else:
        out_text = result.stdout
        if judge_summary is not None:
            try:
                payload = json.loads(result.stdout)
                if isinstance(payload, dict):
                    payload["llm_judge"] = judge_summary
                    out_text = json.dumps(payload, ensure_ascii=False)
            except (json.JSONDecodeError, ValueError):
                pass  # queue 出力が想定外形式でも従来どおり生の stdout を書く（continue）
        out_path.write_text(out_text, encoding="utf-8")
        print(f"[evolve-daily-run] wrote {out_path} ({len(out_text)} bytes)", flush=True)

    # 3) icebox 棚卸しの気づきトリガー（read-only gh issue list、#194）。失敗しても
    # daily-run 全体は落とさない（ingest/tokens と同じ fail-open）。gh バイナリ自体が
    # 無い環境（FileNotFoundError 等）・非ゼロ終了・想定外の JSON 形状のいずれも
    # 既存 icebox-status.json を壊さず（書き込みをスキップして前回生成分を残す）継続する。
    icebox_path = data_dir / ICEBOX_STATUS_FILE_NAME
    print(f"[evolve-daily-run] gh issue list --label icebox --state closed …", flush=True)
    try:
        gh_result = subprocess.run(
            [
                "gh",
                "issue",
                "list",
                "--repo",
                ICEBOX_REPO,
                "--label",
                "icebox",
                "--state",
                "closed",
                "--json",
                "closedAt",
                "--limit",
                str(ICEBOX_GH_LIST_LIMIT),
            ],
            capture_output=True,
            text=True,
            timeout=ICEBOX_GH_TIMEOUT_SECONDS,
        )
    except (OSError, subprocess.TimeoutExpired) as e:
        print(f"[evolve-daily-run] gh issue list error: {e}（continue）", file=sys.stderr, flush=True)
    else:
        if gh_result.returncode != 0:
            print(
                f"[evolve-daily-run] gh issue list exited {gh_result.returncode}（continue）: {gh_result.stderr}",
                file=sys.stderr,
                flush=True,
            )
        else:
            try:
                issues = json.loads(gh_result.stdout)
                if not isinstance(issues, list):
                    raise ValueError(f"expected list, got {type(issues).__name__}")
                now = datetime.now(timezone.utc)
                oldest_days, parsed = _icebox_oldest_days(issues, now)
                if issues and parsed == 0:
                    # count>0 なのにパース成功 0 件＝gh の JSON 形式変更等で機能が
                    # 恒久沈黙するモード。書き込みは続けるが warning で可視化する。
                    print(
                        f"[evolve-daily-run] icebox closedAt parse 0/{len(issues)}"
                        "（gh JSON 形式変更の疑い・oldest_days=0 で通知は沈黙）",
                        file=sys.stderr,
                        flush=True,
                    )
                # #352 B8: gh --limit に達した＝新しい順に返る gh の性質上、最古集合
                # （このステップの oldest_days が直接対象）が切り捨てられている疑いがある。
                truncated = len(issues) >= ICEBOX_GH_LIST_LIMIT
                if truncated:
                    print(
                        f"[evolve-daily-run] icebox status: --limit {ICEBOX_GH_LIST_LIMIT} "
                        "に到達（実件数がこれを超える場合、最古集合が取得できていません）",
                        file=sys.stderr,
                        flush=True,
                    )
                payload = {
                    "count": len(issues),
                    "oldest_days": oldest_days,
                    "generated_at": now.isoformat(),
                    "truncated": truncated,
                }
                atomic_write_text(icebox_path, json.dumps(payload))
                print(f"[evolve-daily-run] wrote {icebox_path} ({payload['count']} icebox issues)", flush=True)
            except (json.JSONDecodeError, ValueError) as e:
                print(f"[evolve-daily-run] icebox status parse error: {e}（continue）", file=sys.stderr, flush=True)

    # 4) icebox 3レーン棚卸し（#352）。read-only gh issue list（body/closedAt/updatedAt）で
    # reopen-when ブロックを取得し、icebox_reconcile.build_verdicts で決定論分類する。
    # 失敗しても daily-run 全体は落とさない（fail-open、上の icebox 集計ステップと同型）。
    verdicts_path = Path(plist_mod.icebox_verdicts_json_path(str(data_dir)))
    print(f"[evolve-daily-run] gh issue list --json number,body,closedAt,updatedAt …", flush=True)
    try:
        gh_reconcile_result = subprocess.run(
            [
                "gh",
                "issue",
                "list",
                "--repo",
                ICEBOX_REPO,
                "--label",
                "icebox",
                "--state",
                "closed",
                "--json",
                "number,body,closedAt,updatedAt",
                "--limit",
                str(ICEBOX_GH_LIST_LIMIT),
            ],
            capture_output=True,
            text=True,
            timeout=ICEBOX_GH_TIMEOUT_SECONDS,
        )
    except (OSError, subprocess.TimeoutExpired) as e:
        print(f"[evolve-daily-run] icebox reconcile gh error: {e}（continue）", file=sys.stderr, flush=True)
    else:
        if gh_reconcile_result.returncode != 0:
            print(
                f"[evolve-daily-run] icebox reconcile gh exited {gh_reconcile_result.returncode}"
                f"（continue）: {gh_reconcile_result.stderr}",
                file=sys.stderr,
                flush=True,
            )
        else:
            try:
                issues = json.loads(gh_reconcile_result.stdout)
                if not isinstance(issues, list):
                    raise ValueError(f"expected list, got {type(issues).__name__}")
                # #352 B8: レーン3「失効候補」はまさに最古集合が対象なので、切り捨てが
                # 起きると「失効候補 0件 ✓」という嘘の clean を出しうる。可視化する。
                truncated = len(issues) >= ICEBOX_GH_LIST_LIMIT
                if truncated:
                    print(
                        f"[evolve-daily-run] icebox reconcile: --limit {ICEBOX_GH_LIST_LIMIT} "
                        "に到達（レーン3の最古集合が欠落している疑い）",
                        file=sys.stderr,
                        flush=True,
                    )
                payload = icebox_reconcile.build_verdicts(issues, data_dir=data_dir)
                payload["truncated"] = truncated
                atomic_write_text(verdicts_path, json.dumps(payload, ensure_ascii=False))
                print(
                    f"[evolve-daily-run] wrote {verdicts_path} "
                    f"({len(payload['verdicts'])} verdicts)",
                    flush=True,
                )
            except Exception as e:
                # #352 B1: untrusted YAML の型エラー等、icebox_reconcile 側の想定外例外も
                # ここで吸収し daily-run 全体を落とさない（従来は JSONDecodeError/ValueError
                # のみを捕捉しており TypeError 等で daily runner がクラッシュしていた）。
                print(
                    f"[evolve-daily-run] icebox reconcile parse error: {e}（continue）",
                    file=sys.stderr,
                    flush=True,
                )

    return queue_rc


if __name__ == "__main__":
    raise SystemExit(main())
